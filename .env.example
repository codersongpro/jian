# Supabase > Project Settings > API. Public anon key, never the service role here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Do not add NEXT_PUBLIC_ to this name.
SUPABASE_SERVICE_ROLE_KEY=
# Explicit local-only candidate preview. Ignored in production even if 1.
CONTENT_REVIEW_MODE=0
